{
  "name": "groundstate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/prebuild-data.mjs",
    "check:look": "node scripts/check-look.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check": "npm run typecheck && npm run check:look && npm run build && npm run check:budget && npm run check:links && npm run check:data"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
