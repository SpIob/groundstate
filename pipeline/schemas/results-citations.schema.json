{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "results/citations.json",
  "description": "Contract change named by W-008: maps citation ids used in promoted results to their display/reference metadata, so the site can render the citations column without reading references/literature/. Fields follow the citation record in references/CITATION_STANDARD.md. verified must be true: an entry whose source was never opened live never enters results/.",
  "type": "object",
  "properties": {
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "paper",
              "database",
              "dataset",
              "software"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "const": "UNVERIFIED"
              }
            ]
          },
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "const": true
          },
          "verified_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "authors",
          "year",
          "identifier",
          "version",
          "accessed_at",
          "verified",
          "verified_by"
        ]
      }
    }
  },
  "required": [
    "citations"
  ]
}
